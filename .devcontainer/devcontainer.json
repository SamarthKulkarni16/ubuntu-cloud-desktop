{
  "name": "Ubuntu XFCE Desktop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Ubuntu XFCE Desktop",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-desktop.sh",
  "customizations": {
    "codespaces": {
      "openFiles": []
    }
  }
}
